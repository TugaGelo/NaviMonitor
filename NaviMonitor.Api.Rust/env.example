# Copy to .env for local development. Never commit .env.
PORT=8080
DATABASE_URL=postgres://navi:navi@localhost:5433/navimonitor
FIREBASE_PROJECT_ID=navi-monitor
# Comma-separated Google account emails allowed to use the API.
ALLOWED_EMAILS=you@gmail.com
# Comma-separated browser origins (the web app). Mobile apps don't need this.
CORS_ORIGINS=http://localhost:5173
# Needed from step 6 (manual analysis).
GEMINI_API_KEY=
RUST_LOG=navimonitor_api=debug,tower_http=info
